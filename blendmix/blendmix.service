[Unit]
Description=blendmix Gemini image blender service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=blendmix
Group=blendmix
EnvironmentFile=/etc/blendmix.env
ExecStart=/usr/local/bin/blendmix
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/blendmix

[Install]
WantedBy=multi-user.target

